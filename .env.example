# --- GitHub App credentials (from your App's settings page) ---
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=choose-a-long-random-string

# Provide the App private key ONE of two ways:
# 1) Inline, with literal \n for newlines:
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEp...\n-----END RSA PRIVATE KEY-----\n"
# 2) Or a path to the downloaded .pem (takes precedence if set):
# GITHUB_PRIVATE_KEY_PATH=./private-key.pem

# --- Ollama (local model — no API key needed) ---
# Make sure `ollama serve` is running and you've pulled the model below.
OLLAMA_HOST=http://127.0.0.1:11434
# A coder-tuned or strong general model works best for review.
OLLAMA_MODEL=qwen3:8b
# Context window in tokens. Ollama defaults to 4096, too small for real diffs.
OLLAMA_NUM_CTX=16384

# --- Behaviour ---
PORT=3000
# Skip pull requests still in draft state.
SKIP_DRAFTS=true
# Hard cap on how much diff text (chars) is sent to the model per PR.
MAX_DIFF_CHARS=60000
