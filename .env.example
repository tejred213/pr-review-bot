# --- GitHub App credentials (from your App's settings page) ---
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=choose-a-long-random-string

# Provide the App private key ONE of two ways:
# 1) Inline, with literal \n for newlines:
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEp...\n-----END RSA PRIVATE KEY-----\n"
# 2) Or a path to the downloaded .pem (takes precedence if set):
# GITHUB_PRIVATE_KEY_PATH=./private-key.pem

# --- LLM (any OpenAI-compatible provider) ---
# Defaults to a local Ollama (run `ollama serve`, `ollama pull qwen3:8b`).
# Swap provider by changing these three lines. Examples:
#   Ollama:     http://127.0.0.1:11434/v1             (model: qwen3:8b)  [default]
#   Groq:       https://api.groq.com/openai/v1        (model: llama-3.3-70b-versatile)
#   OpenAI:     https://api.openai.com/v1             (model: gpt-4o-mini)
#   OpenRouter: https://openrouter.ai/api/v1          (model: meta-llama/llama-3.3-70b-instruct)
#   Together:   https://api.together.xyz/v1           (model: meta-llama/Llama-3.3-70B-Instruct-Turbo)
LLM_BASE_URL=http://127.0.0.1:11434/v1
# For local Ollama any non-empty value works; set a real key for cloud providers.
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# --- Behaviour ---
PORT=3000
# Skip pull requests still in draft state.
SKIP_DRAFTS=true
# Hard cap on how much diff text (chars) is sent to the model per PR.
MAX_DIFF_CHARS=60000
